# Copy to .env and set your values. Never commit .env.

# Required for AI test generation (npm run generate:tests)
OPENAI_API_KEY=

# Optional: base URL for Playwright tests (default: https://example.com)
# BASE_URL=https://example.com

# Optional: where to write generated tests (default: tests/ai-generated.spec.ts)
# OUTPUT_PATH=tests/ai-generated.spec.ts
