# Copy to .env and set your values. Never commit .env.

# Required for AI test generation (npm run generate:tests / generate:tests:api)
OPENAI_API_KEY=

# Optional: model for generation (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: preset environment when BASE_URL / API_BASE_URL are not set.
# Values: default | local | staging | production
# TEST_ENV=default

# Optional: base URL for UI Playwright tests (default from preset / example.com)
# BASE_URL=https://example.com

# Optional: base URL for API-only specs in tests/api/ (default: jsonplaceholder)
# API_BASE_URL=https://jsonplaceholder.typicode.com

# Optional: where to write generated tests (defaults depend on TEST_GEN_MODE)
# OUTPUT_PATH=tests/ui/my-flow.spec.ts

# Optional: ui | api — which generator prompt to use (npm run generate:tests respects this)
# TEST_GEN_MODE=ui

# Optional: primary target for ZAP baseline (npm run test:security / compose zap-scan)
# SECURITY_TARGET_URL=https://example.com

# Optional: set to 1 to skip WebKit UI project (e.g. Linux without playwright system deps)
# SKIP_WEBKIT=1
