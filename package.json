{
  "name": "ai-qa-automation-starter",
  "version": "0.1.0",
  "description": "AI-powered QA automation starter kit for Playwright tests.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:security": "bash scripts/zap-baseline-docker.sh",
    "test:ui:headed": "playwright test --headed --project=ui-chromium",
    "test:ui:debug": "playwright test --debug --project=ui-chromium",
    "test:ui:interactive": "playwright test --ui",
    "generate:tests": "tsx src/ai/generate-tests.ts",
    "generate:tests:api": "TEST_GEN_MODE=api tsx src/ai/generate-tests.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "ai",
    "openai",
    "testing",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "openai": "^4.73.0"
  },
  "engines": {
    "node": ">=20"
  }
}
